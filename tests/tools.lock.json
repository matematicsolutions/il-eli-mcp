{
  "package_version": "0.5.3",
  "tools": {
    "il_coverage": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Declare what this connector covers, how it is sourced, and what it does NOT cover.\n\nCall this before telling a user that the law \"does not contain\" something, and whenever\na search comes back empty: the absence may be a gap in this connector rather than in the\nlaw. Every gap carries a fallback saying where to look instead.\n\nReturns:\n    ``Coverage`` with families, an as-of note, and a non-empty list of known gaps.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "il_coverage",
        "outputSchema": {
          "additionalProperties": true,
          "description": "What this connector covers, how it is sourced, and what it does not cover.",
          "properties": {
            "as_of_note": {
              "description": "States what the dates mean, and what they do not promise.",
              "type": "string"
            },
            "families": {
              "items": {
                "additionalProperties": true,
                "description": "One data family this connector exposes.",
                "properties": {
                  "captured_at": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "description": "Date this family was last captured (ISO). None when queried live."
                  },
                  "live": {
                    "default": true,
                    "description": "True when queried live instead of from a snapshot.",
                    "type": "boolean"
                  },
                  "name": {
                    "description": "Data family, e.g. 'Federal legislation'.",
                    "type": "string"
                  },
                  "source": {
                    "description": "Official source the data comes from.",
                    "type": "string"
                  },
                  "tool": {
                    "description": "Tool or tools that reach this family.",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "tool",
                  "source"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "known_gaps": {
              "description": "Never empty. An empty list would mean 'not checked', not 'no gaps'.",
              "items": {
                "additionalProperties": true,
                "description": "A known, named hole in this connector's coverage - plus the way around it.",
                "properties": {
                  "fallback": {
                    "description": "Where to go instead.",
                    "type": "string"
                  },
                  "family": {
                    "description": "Which family the gap belongs to.",
                    "type": "string"
                  },
                  "id": {
                    "description": "Stable gap identifier.",
                    "type": "string"
                  },
                  "missing": {
                    "description": "What is NOT available through this connector.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "family",
                  "missing",
                  "fallback"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "status": {
              "default": "ok",
              "enum": [
                "ok",
                "degraded",
                "failed"
              ],
              "type": "string"
            }
          },
          "required": [
            "as_of_note"
          ],
          "type": "object"
        }
      },
      "sha256": "7f36f7ad65834e7d26e18dc7e8ab0b9fb5c58243a3fe3dca3e0d7f68e9c290ac"
    },
    "il_get_case": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Fetch full detail (including full judgment text) for one case by its judgment_id.\n\nReads from the same locally-cached dataset as `il_search_case_law` - see\nthat tool's docstring for the download/caching/license notes.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "judgment_id": {
              "description": "the dataset's ``judgment_id`` (from `il_search_case_law` results).",
              "type": "string"
            }
          },
          "required": [
            "judgment_id"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "il_get_case",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "5ceb151889a86d2c23802f1790ab0119a35f87eafeeec1dd8457ee39322d8758"
    },
