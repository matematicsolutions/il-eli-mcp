    "il_search_case_law": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Keyword search over a local, pre-downloaded corpus of Israeli court judgments.\n\nNOT a live API call. The corpus (10,558 Hebrew judgments from Family,\nDistrict, Magistrate, Labor, Military and Administrative courts) is a\nstatic HuggingFace dataset (`guychuk/case-law-israel`) downloaded once\nand cached locally on first use of this tool - later calls only touch\nthe local cache. Its license is undocumented; treat results as for\nanalysis, not for redistribution.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "court": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "optional substring filter on the court type label (Hebrew), e.g. a\nfragment of \"בית משפט השלום\" (Magistrate) or \"בית דין לעבודה\" (Labor)."
            },
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "free text in Hebrew, matched against title/full text/judges/case number.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "il_search_case_law",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "a6e7214e9f9d614a7a9567d884bc0e53223d4e173d5fd521dec2cd12cbfa9253"
    },
    "il_search_law_texts": {
      "descriptor": {
        "annotations": {
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": true,
          "readOnlyHint": true
        },
        "description": "Search published Israeli law versions (KNS_Law), including consolidated texts.\n\nComplements `il_search_laws`: that tool covers the KNS_IsraelLaw registry\n(validity status, Basic Law flag), this one covers KNS_Law - the published\nversions whose official PDF documents are reachable via\n`il_get_law_documents`. The two id spaces are disjoint.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "default": 20,
              "description": "max results (default 20).",
              "type": "integer"
            },
            "query": {
              "description": "free text in Hebrew, matched against the published version's name.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "meta": {
          "fastmcp": {
            "tags": []
          }
        },
        "name": "il_search_law_texts",
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "sha256": "560c4c14aedbd26612b72a69573d2a4781c624fd41c24e03d35708df1675ab74"
    },
    "il_search_laws": {
